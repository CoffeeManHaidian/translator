  <property name="styleSheet">
   <string notr="true">QDialog#floating_dialog {
    color: #0F172A;
    background-color: #F8FAFC;
}

QLabel#translation_direction_label,
QLabel#source_text_label,
QLabel#translation_text_label {
    color: #334155;
    font-size: 12px;
    font-weight: 600;
}

QWidget#translation_direction_widget {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QLabel#source_language_label {
    min-height: 26px;
    max-height: 26px;
    padding: 0 10px;
    color: #475569;
    background-color: #F1F5F9;
    border: none;
    border-radius: 6px;
}

QLabel#translation_direction_icon_label {
    background-color: transparent;
    border: none;
}

QComboBox#target_language_combo_box {
    min-height: 26px;
    max-height: 26px;
    padding: 0 28px 0 9px;
    color: #0F172A;
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 7px;
}

QComboBox#target_language_combo_box:hover {
    border-color: #94A3B8;
}

QComboBox#target_language_combo_box:focus {
    border-color: #2563EB;
}

QComboBox#target_language_combo_box::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 26px;
    background-color: transparent;
    border: none;
}

QComboBox#target_language_combo_box::down-arrow {
    image: url(:/settings/icons/chevron-down.svg);
    width: 10px;
    height: 10px;
}

QComboBox#target_language_combo_box QAbstractItemView {
    padding: 4px;
    color: #0F172A;
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    outline: none;
    selection-color: #1E3A8A;
    selection-background-color: #EFF6FF;
}

QComboBox#target_language_combo_box QAbstractItemView::item {
    min-height: 26px;
    padding: 0 8px;
}

QPlainTextEdit#source_text_edit {
    padding: 9px 10px;
    color: #0F172A;
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    selection-color: #1E3A8A;
    selection-background-color: #DBEAFE;
}

QWidget#translation_output_widget {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QPlainTextEdit#translation_text_edit {
    padding: 9px 10px;
    color: #0F172A;
    background-color: #FFFFFF;
    border: none;
    border-radius: 7px;
    selection-color: #1E3A8A;
    selection-background-color: #DBEAFE;
}

QPlainTextEdit#source_text_edit:hover,
QWidget#translation_output_widget:hover {
    border-color: #94A3B8;
}

QPlainTextEdit#source_text_edit:focus {
    border-color: #2563EB;
}

QPushButton#copy_translation_push_button {
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    background-color: transparent;
    border: none;
    border-radius: 6px;
}

QPushButton#copy_translation_push_button:hover {
    background-color: #F1F5F9;
}

QPushButton#copy_translation_push_button:pressed {
    background-color: #E2E8F0;
}

QPushButton#copy_translation_push_button:focus {
    background-color: #EFF6FF;
}

QPlainTextEdit QScrollBar:vertical {
    width: 8px;
    margin: 4px 1px;
    background-color: transparent;
}

QPlainTextEdit QScrollBar::handle:vertical {
    min-height: 20px;
    background-color: #CBD5E1;
    border-radius: 3px;
}

QPlainTextEdit QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}

QPlainTextEdit QScrollBar::add-line:vertical,
QPlainTextEdit QScrollBar::sub-line:vertical {
    height: 0;
    background-color: transparent;
    border: none;
}

QPlainTextEdit QScrollBar::add-page:vertical,
QPlainTextEdit QScrollBar::sub-page:vertical {
    background-color: transparent;
}</string>
