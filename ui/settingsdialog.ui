         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QVBoxLayout" name="model_field_layout">
        <property name="spacing"><number>4</number></property>
        <item><widget class="QLabel" name="model_label"><property name="text"><string>模型</string></property></widget></item>
        <item>
         <layout class="QHBoxLayout" name="model_control_layout">
          <property name="spacing"><number>6</number></property>
          <item><widget class="QComboBox" name="model_comboBox"/></item>
          <item>
           <widget class="QPushButton" name="refresh_models_pushButton">
            <property name="toolTip"><string>刷新模型列表</string></property>
            <property name="accessibleName"><string>刷新模型列表</string></property>
            <property name="text"><string/></property>
            <property name="icon"><iconset resource="../resource.qrc"><normaloff>:/mainwindow/icons/rotate-ccw-clock.svg</normaloff>:/mainwindow/icons/rotate-ccw-clock.svg</iconset></property>
            <property name="iconSize"><size><width>16</width><height>16</height></size></property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QVBoxLayout" name="api_key_field_layout">
        <property name="spacing"><number>4</number></property>
        <item><widget class="QLabel" name="api_key_label"><property name="text"><string>API Key</string></property></widget></item>
        <item>
         <layout class="QHBoxLayout" name="api_key_control_layout">
          <property name="spacing"><number>6</number></property>
          <item>
           <widget class="QLineEdit" name="api_key_lineEdit">
            <property name="accessibleName"><string>API Key</string></property>
            <property name="echoMode"><enum>QLineEdit::EchoMode::Password</enum></property>
            <property name="placeholderText"><string>请输入 API Key</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="visibility_pushButton">
            <property name="toolTip"><string>显示 API Key</string></property>
            <property name="accessibleName"><string>显示 API Key</string></property>
            <property name="text"><string/></property>
            <property name="icon"><iconset resource="../resource.qrc"><normaloff>:/settings/icons/eye.svg</normaloff>:/settings/icons/eye.svg</iconset></property>
            <property name="iconSize"><size><width>16</width><height>16</height></size></property>
            <property name="checkable"><bool>true</bool></property>
           </widget>
          </item>
          <item><widget class="QPushButton" name="test_pushButton"><property name="text"><string>测试连接</string></property></widget></item>
          <item>
           <widget class="QLabel" name="status_label">
            <property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Preferred"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property>
            <property name="text"><string/></property>
           </widget>
          </item>
         </layout>
        </item>
        <item><widget class="QLabel" name="api_key_hint_label"><property name="text"><string>密钥仅保存在当前设备</string></property></widget></item>
       </layout>
      </item>
      <item>
       <layout class="QVBoxLayout" name="hotkey_field_layout">
        <property name="spacing"><number>4</number></property>
        <item><widget class="QLabel" name="hotkey_label"><property name="text"><string>全局快捷键</string></property></widget></item>
        <item>
         <widget class="QKeySequenceEdit" name="hotkey_keySequenceEdit">
          <property name="maximumSequenceLength"><number>1</number></property>
          <property name="clearButtonEnabled"><bool>true</bool></property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QPushButton" name="advanced_toggleButton">
        <property name="toolTip"><string>展开高级设置</string></property>
        <property name="accessibleName"><string>展开高级设置</string></property>
        <property name="text"><string>高级设置</string></property>
        <property name="icon"><iconset resource="../resource.qrc"><normaloff>:/settings/icons/chevron-down.svg</normaloff>:/settings/icons/chevron-down.svg</iconset></property>
        <property name="iconSize"><size><width>14</width><height>14</height></size></property>
        <property name="checkable"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <widget class="QWidget" name="advanced_widget" native="true">
        <layout class="QVBoxLayout" name="advanced_layout">
         <property name="spacing"><number>4</number></property>
